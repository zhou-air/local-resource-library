<Window x:Class="LocalResourceLibrary.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Text[Title]}" Style="{StaticResource {x:Type Window}}"
        Width="1420" Height="860" MinWidth="1080" MinHeight="650" WindowStartupLocation="CenterScreen"
        AllowDrop="True" PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop"
        Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
  <Window.Resources>
    <Style x:Key="NavigationItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="12,12"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Grid>
          <Border x:Name="SelectionSurface" CornerRadius="8" Background="{DynamicResource AccentSoft}" Opacity="0"/>
          <Border x:Name="HoverSurface" CornerRadius="8" Background="{DynamicResource Line}" Opacity="0"/>
          <Border x:Name="SelectionMark" Width="3" Height="18" CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Opacity="0"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverSurface" Property="Opacity" Value="0.3"/></Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="SelectionSurface" Property="Opacity" Value="1"/>
            <Setter TargetName="HoverSurface" Property="Opacity" Value="0"/>
            <Setter TargetName="SelectionMark" Property="Opacity" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/>
          </Trigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
              <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="SelectionSurface" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" FillBehavior="Stop"/>
            </Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
          </MultiDataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NavigationIcon" TargetType="Path" BasedOn="{StaticResource SmallIcon}">
      <Setter Property="Data" Value="M 1,4 L 6,4 L 8,6 L 17,6 L 17,15 L 1,15 Z"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Id}" Value="@all"><Setter Property="Data" Value="M 1,1 L 7,1 L 7,7 L 1,7 Z M 11,1 L 17,1 L 17,7 L 11,7 Z M 1,11 L 7,11 L 7,17 L 1,17 Z M 11,11 L 17,11 L 17,17 L 11,17 Z"/></DataTrigger>
        <DataTrigger Binding="{Binding Id}" Value="@recent"><Setter Property="Data" Value="M 17,9 A 8,8 0 1 1 1,9 A 8,8 0 1 1 17,9 M 9,4 L 9,9 L 13,11"/></DataTrigger>
        <DataTrigger Binding="{Binding Id}" Value="@missing"><Setter Property="Data" Value="M 17,9 A 8,8 0 1 1 1,9 A 8,8 0 1 1 17,9 M 9,4 L 9,10 M 9,13 L 9,14"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ResourceIcon" TargetType="Path" BasedOn="{StaticResource SmallIcon}">
      <Setter Property="Width" Value="18"/><Setter Property="Height" Value="22"/>
      <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
      <Setter Property="Data" Value="M 2,1 L 11,1 L 16,6 L 16,21 L 2,21 Z M 11,1 L 11,6 L 16,6 M 6,11 L 12,11 M 6,15 L 12,15"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Item.Type}" Value="folder"><Setter Property="Height" Value="17"/><Setter Property="Data" Value="M 1,3 L 7,3 L 9,5 L 19,5 L 19,16 L 1,16 Z M 1,8 L 19,8"/></DataTrigger>
        <DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Stroke" Value="{DynamicResource Warning}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ResourceRowStyle" TargetType="DataGridRow">
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Raised}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ResourceCell" TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="StatusPill" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SuccessSoft}"/><Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="8,4"/><Setter Property="HorizontalAlignment" Value="Left"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Background" Value="{DynamicResource WarningSoft}"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Success}"/><Setter Property="FontSize" Value="11"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource PanelMaterial}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,17">
      <Grid IsEnabled="{Binding IsReady}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center" Margin="0,0,13,0">
            <Viewbox Width="25" Height="25"><Canvas Width="26" Height="26">
              <Path Data="M 3,3 L 7,3 L 7,23 L 3,23 Z M 10,3 L 14,3 L 14,23 L 10,23 Z M 17,5 L 21,4 L 25,22 L 21,23 Z" Fill="{DynamicResource Accent}"/>
              <Path Data="M 1,25 L 25,25" Stroke="{DynamicResource Accent}" StrokeThickness="1.5"/>
            </Canvas></Viewbox>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Text[Title]}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Text[Subtitle]}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding Text[Add]}" Click="Add_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Add resources"/>
          <Button Content="{Binding Text[Refresh]}" Click="Refresh_Click" Margin="0,0,14,0"/>
          <ComboBox x:Name="LanguageBox" Width="110" SelectionChanged="Language_Changed" ToolTip="{Binding Text[Language]}" AutomationProperties.Name="Language">
            <ComboBoxItem Tag="zh-CN">简体中文</ComboBoxItem><ComboBoxItem Tag="en">English</ComboBoxItem>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" IsEnabled="{Binding IsReady}" Margin="14,16,14,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="224" MinWidth="194"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="380"/><ColumnDefinition Width="10"/><ColumnDefinition Width="350" MinWidth="300"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource PanelMaterial}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="10,17,10,12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Text[Projects]}" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,14"/>
          <Button DockPanel.Dock="Bottom" Content="{Binding Text[NewProject]}" Click="NewProject_Click" Margin="0,14,0,0" HorizontalAlignment="Stretch"/>
          <ListBox x:Name="NavigationList" ItemsSource="{Binding Navigation}" BorderThickness="0" Background="Transparent"
                   SelectionChanged="Navigation_Changed" ContextMenuOpening="Navigation_ContextMenuOpening" HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource NavigationItem}" AutomationProperties.Name="Projects">
            <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
            <ListBox.ItemTemplate><DataTemplate>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Path Style="{StaticResource NavigationIcon}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="9" Padding="6,2" Margin="6,0,0,0" MinWidth="23">
                  <TextBlock Text="{Binding Count}" Foreground="{DynamicResource Muted}" FontSize="11" TextAlignment="Center"/>
                </Border>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" ToolTip="{Binding Text[ResizePane]}"/>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="4,1,4,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding ViewTitle}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,14">
          <TextBox x:Name="SearchBox" Height="42" Padding="37,10,82,10" TextChanged="Search_Changed" ToolTip="{Binding Text[Search]}" AutomationProperties.Name="Search"/>
          <Path Data="M 12,7 A 5,5 0 1 1 2,7 A 5,5 0 1 1 12,7 M 11,11 L 16,16" Style="{StaticResource SmallIcon}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False"/>
          <TextBlock Text="{Binding Text[Search]}" Foreground="{DynamicResource Muted}" Margin="37,0,83,0" IsHitTestVisible="False" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
            <TextBlock Text="Ctrl F" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" IsHitTestVisible="False"/>
            <Button Content="×" Click="ClearSearch_Click" Style="{StaticResource IconButton}" Margin="0" FontSize="17" ToolTip="{Binding Text[ClearSearch]}" AutomationProperties.Name="Clear search"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
          <!-- The shadow is applied to the backing surface, keeping list text crisp. -->
          <Border Background="{DynamicResource Surface}" CornerRadius="10" Effect="{DynamicResource PanelShadow}"/>
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="1,6,1,6">
            <DataGrid x:Name="ResourceGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                      BorderThickness="0" Background="{DynamicResource Surface}" RowHeaderWidth="0" EnableRowVirtualization="True"
                      ScrollViewer.CanContentScroll="True" RowStyle="{StaticResource ResourceRowStyle}" CellStyle="{StaticResource ResourceCell}"
                      SelectionChanged="Resource_SelectionChanged" MouseDoubleClick="Resource_DoubleClick" PreviewMouseRightButtonDown="Resource_RightButtonDown"
                      ContextMenuOpening="Resource_ContextMenuOpening" AutomationProperties.Name="Resources">
              <DataGrid.ContextMenu><ContextMenu/></DataGrid.ContextMenu>
              <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                <Setter Property="Padding" Value="14,10"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
              </Style></DataGrid.ColumnHeaderStyle>
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <Grid Margin="13,14" ToolTip="{Binding Target}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="38" CornerRadius="6" Background="{DynamicResource Raised}" VerticalAlignment="Top" Margin="0,1,11,0"><Path Style="{StaticResource ResourceIcon}"/></Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="18" Margin="0,4,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Description}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                      </TextBlock>
                      <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,9,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding RealName}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                    </StackPanel>
                  </Grid>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Width="112"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <TextBlock Text="{Binding ProjectNames}" Margin="10,16,8,10" TextWrapping="Wrap" MaxHeight="64" ToolTip="{Binding ProjectNames}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Width="76"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <Border Style="{StaticResource StatusPill}" Margin="3,14,4,0" VerticalAlignment="Top"><TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/></Border>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <Border Visibility="{Binding EmptyVisibility}" Background="{DynamicResource Surface}" CornerRadius="10" IsHitTestVisible="False" Padding="25">
            <StackPanel VerticalAlignment="Center">
              <Border Width="68" Height="68" CornerRadius="18" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
                <Path Data="M 2,5 L 12,5 L 16,9 L 29,9 L 29,27 L 2,27 Z M 10,18 L 22,18 M 16,12 L 16,24" Style="{StaticResource SmallIcon}" Width="31" Height="31" Stroke="{DynamicResource Accent}"/>
              </Border>
              <TextBlock Text="{Binding EmptyTitle}" FontSize="19" FontWeight="SemiBold" Margin="0,22,0,10" TextAlignment="Center" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding EmptyHelp}" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="23"/>
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Text[DropHint]}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="4,12,0,0"/>
      </Grid>
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" Background="Transparent" ToolTip="{Binding Text[ResizePane]}"/>
      <Border Grid.Column="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
        <Grid>
          <StackPanel Visibility="{Binding ChooseVisibility}" VerticalAlignment="Center" Margin="28">
            <Border Width="48" Height="48" CornerRadius="13" Background="{DynamicResource Raised}" HorizontalAlignment="Left" Margin="0,0,18,18">
              <Path Data="M 2,2 L 17,2 L 17,21 L 2,21 Z M 6,7 L 13,7 M 6,12 L 13,12 M 6,17 L 10,17" Style="{StaticResource SmallIcon}" Width="20" Height="23"/>
            </Border>
            <TextBlock Text="{Binding Text[ChooseItem]}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Text[ChooseHelp]}" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="23"/>
          </StackPanel>
          <DockPanel Visibility="{Binding DetailsVisibility}">
            <Border DockPanel.Dock="Top" Padding="20,18,20,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
              <StackPanel><TextBlock Text="{Binding Text[Details]}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SaveState}" FontSize="11" Margin="0,5,0,0">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding IsDirty}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelMaterial}" CornerRadius="0,0,10,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14">
              <StackPanel Orientation="Horizontal">
                <Button Content="{Binding Text[Save]}" Click="Save_Click" IsEnabled="{Binding IsDirty}" Style="{StaticResource PrimaryButton}" MinWidth="86" AutomationProperties.Name="Save details"/>
                <Button Content="{Binding Text[Discard]}" Click="Discard_Click" IsEnabled="{Binding IsDirty}" Margin="0" Padding="10,9"/>
              </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="20,0,20,22">
                <Border Visibility="{Binding MissingVisibility}" Background="{DynamicResource WarningSoft}" CornerRadius="7" Padding="12" Margin="0,16,0,0">
                  <StackPanel><TextBlock Text="{Binding Text[MissingHelp]}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" LineHeight="21"/>
                    <Button Content="{Binding Text[Repair]}" Click="Repair_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding Text[Alias]}" Style="{StaticResource Label}"/><TextBox x:Name="AliasBox" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Alias"/>
                <TextBlock Text="{Binding Text[AliasHelp]}" Style="{StaticResource HelpText}"/>
                <TextBlock Text="{Binding Text[Description]}" Style="{StaticResource Label}"/>
                <TextBox x:Name="DescriptionBox" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="96" MaxHeight="180" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Description"/>
                <TextBlock Text="{Binding Text[DescriptionHelp]}" Style="{StaticResource HelpText}"/>
                <TextBlock Text="{Binding Text[Note]}" Style="{StaticResource Label}"/>
                <TextBox x:Name="NoteBox" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="68" MaxHeight="160" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Note"/>
                <TextBlock Text="{Binding Text[Membership]}" Style="{StaticResource Label}"/>
                <TextBlock Text="{Binding Text[NoProjects]}" Visibility="{Binding NoProjectsVisibility}" Style="{StaticResource HelpText}" Margin="0"/>
                <ItemsControl ItemsSource="{Binding Memberships}"><ItemsControl.ItemTemplate><DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></CheckBox>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
                  <WrapPanel><Button Content="{Binding Text[Open]}" Click="Open_Click" Margin="0,0,8,8"/><Button Content="{Binding Text[OpenLocation]}" Click="Location_Click" Margin="0,0,0,8"/></WrapPanel>
                </Border>
                <TextBlock Text="{Binding Text[RealName]}" Style="{StaticResource Label}"/><TextBox Text="{Binding Selected.RealName, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}"/>
                <TextBlock Text="{Binding Text[Path]}" Style="{StaticResource Label}"/><TextBox Text="{Binding Selected.Target, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}"/>
                <WrapPanel Margin="0,10,0,0"><Button Content="{Binding Text[CopyPath]}" Click="CopyPath_Click" Margin="0,0,8,8"/><Button Content="{Binding Text[Repair]}" Click="Repair_Click" Margin="0,0,0,8"/></WrapPanel>
                <TextBlock Text="{Binding Text[Type]}" Style="{StaticResource Label}"/><TextBlock Text="{Binding Selected.Type}"/>
                <TextBlock Text="{Binding Text[Created]}" Style="{StaticResource Label}"/><TextBlock Text="{Binding CreatedText}"/>
                <TextBlock Text="{Binding Text[Updated]}" Style="{StaticResource Label}"/><TextBlock Text="{Binding UpdatedText}"/>
                <TextBlock Text="{Binding Text[LastOpened]}" Style="{StaticResource Label}"/><TextBlock Text="{Binding LastOpenedText}"/>
                <TextBlock Text="{Binding Text[OpenCount]}" Style="{StaticResource Label}"/><TextBlock Text="{Binding OpenCountText}"/>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Padding="18,8" Background="{DynamicResource Canvas}">
      <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Text[LocalStorage]}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="12,0,0,0"/>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding DatabasePath}"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>

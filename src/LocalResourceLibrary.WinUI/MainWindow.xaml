<Window x:Class="LocalResourceLibrary.WinUI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:LocalResourceLibrary.WinUI.ViewModels"
 xmlns:controls="using:LocalResourceLibrary.WinUI.Controls"
 xmlns:services="using:LocalResourceLibrary.WinUI.Services">
 <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
 <Grid x:Name="Root" Background="Transparent" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged"
       AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" KeyDown="Root_KeyDown">
  <Grid.Resources>
   <services:IconFallbackConverter x:Key="IconFallback"/>
   <SolidColorBrush x:Key="ResourceDropHighlightBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.16"/>
   <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="Margin" Value="0,20,0,8"/></Style>
   <Style x:Key="FieldHelp" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,7,0,0"/></Style>
   <Style x:Key="SplitterStyle" TargetType="controls:PaneSplitter">
    <Setter Property="IsTabStop" Value="True"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:PaneSplitter"><Grid Background="Transparent"><Thumb x:Name="PART_Thumb" IsTabStop="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border Width="1" HorizontalAlignment="Center" Background="{ThemeResource CardStrokeColorDefaultBrush}"/></Grid></ControlTemplate></Thumb.Template></Thumb></Grid></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="HeaderStyle" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="8,5"/><Setter Property="FontSize" Value="12"/></Style>
   <ItemsPanelTemplate x:Key="HorizontalWrap"><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate>
   <ItemsPanelTemplate x:Key="VerticalWrap"><ItemsWrapGrid Orientation="Vertical"/></ItemsPanelTemplate>
   <DataTemplate x:Key="DetailsTemplate" x:DataType="vm:ResourceRow">
    <Grid Padding="8,5" ColumnSpacing="12" ToolTipService.ToolTip="{Binding Target}" Opacity="{Binding ResourceOpacity}"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions>
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="20" Height="20"><FontIcon Glyph="{Binding IconGlyph}" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding Icon, Converter={StaticResource IconFallback}}"/><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid>
     <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Column="2" Text="{Binding Type}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
    </Grid>
   </DataTemplate>
   <DataTemplate x:Key="CompactTemplate" x:DataType="vm:ResourceRow"><Grid Width="220" Height="32" Padding="6,4" ColumnSpacing="8" ToolTipService.ToolTip="{Binding Target}" Opacity="{Binding ResourceOpacity}"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="20" Height="20"><FontIcon Glyph="{Binding IconGlyph}" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding Icon, Converter={StaticResource IconFallback}}"/><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></DataTemplate>
   <DataTemplate x:Key="TilesTemplate" x:DataType="vm:ResourceRow"><Grid Width="270" Height="78" Padding="8" ColumnSpacing="10" ToolTipService.ToolTip="{Binding Target}" Opacity="{Binding ResourceOpacity}"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="48" Height="48"><FontIcon Glyph="{Binding IconGlyph}" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding Icon, Converter={StaticResource IconFallback}}"/><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid><StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13"/><TextBlock Text="{Binding Type}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></DataTemplate>
   <DataTemplate x:Key="ContentTemplate" x:DataType="vm:ResourceRow"><Grid Padding="8,10" ColumnSpacing="12" ToolTipService.ToolTip="{Binding Target}" Opacity="{Binding ResourceOpacity}"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Width="48" Height="48"><FontIcon Glyph="{Binding IconGlyph}" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding Icon, Converter={StaticResource IconFallback}}"/><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Target}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="{Binding ModifiedText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/></StackPanel></Grid></DataTemplate>
   <DataTemplate x:Key="ExtraLargeTemplate" x:DataType="vm:ResourceRow"><StackPanel Width="196" Height="226" Padding="8" Spacing="8" ToolTipService.ToolTip="{Binding Target}" Opacity="{Binding ResourceOpacity}"><Grid Width="160" Height="160"><FontIcon Glyph="{Binding IconGlyph}" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding Icon, Converter={StaticResource IconFallback}}"/><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid><TextBlock Text="{Binding Name}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" HorizontalAlignment="Stretch"/><TextBlock Text="{Binding Status}" Visibility="{Binding MissingVisibility}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center"/></StackPanel></DataTemplate>
   <DataTemplate x:Key="LargeTemplate" x:DataType="vm:ResourceRow"><StackPanel Width="140" Height="166" Padding="8" Spacing="8" ToolTipService.ToolTip="{Binding Target}" Opacity="{Binding ResourceOpacity}"><Grid Width="96" Height="96"><FontIcon Glyph="{Binding IconGlyph}" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding Icon, Converter={StaticResource IconFallback}}"/><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid><TextBlock Text="{Binding Name}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" HorizontalAlignment="Stretch"/><TextBlock Text="{Binding Status}" Visibility="{Binding MissingVisibility}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center"/></StackPanel></DataTemplate>
   <DataTemplate x:Key="MediumTemplate" x:DataType="vm:ResourceRow"><StackPanel Width="112" Height="118" Padding="8" Spacing="8" ToolTipService.ToolTip="{Binding Target}" Opacity="{Binding ResourceOpacity}"><Grid Width="48" Height="48"><FontIcon Glyph="{Binding IconGlyph}" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding Icon, Converter={StaticResource IconFallback}}"/><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid><TextBlock Text="{Binding Name}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" HorizontalAlignment="Stretch"/><TextBlock Text="{Binding Status}" Visibility="{Binding MissingVisibility}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center"/></StackPanel></DataTemplate>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="AppTitleBar" Margin="20,0,150,0" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8F1;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding Text[Title]}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
  <Grid Grid.Row="1" Margin="16,4" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><TextBlock Text="{Binding ViewTitle}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/></StackPanel><Grid Grid.Column="1"><TextBox x:Name="SearchBox" PlaceholderText="{Binding Text[Search]}" Padding="34,7,12,7" TextChanged="Search_Changed" ToolTipService.ToolTip="{Binding Text[Search]}" AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="Search"/><FontIcon Glyph="&#xE721;" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/></Grid></Grid>
  <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
   <Grid Margin="16,4" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button x:Name="AddButton" IsEnabled="{Binding IsReady}" Content="{Binding Text[Add]}" Click="Add_Click" AutomationProperties.AutomationId="AddButton"/>
     <Button x:Name="SelectAllButton" IsEnabled="{Binding IsReady}" Content="{Binding Text[SelectAll]}" Click="SelectAll_Click" AutomationProperties.AutomationId="SelectAllButton"/>
     <Button x:Name="DeleteResourcesButton" IsEnabled="{Binding CanDeleteResources}" Content="{Binding Text[DeleteResources]}" Click="DeleteResources_Click" AutomationProperties.AutomationId="DeleteResourcesButton"/>
     <Button x:Name="UndoButton" Click="Undo_Click" IsEnabled="False" AutomationProperties.AutomationId="UndoButton" AutomationProperties.Name="{Binding Text[Undo]}"><FontIcon Glyph="&#xE7A7;" FontSize="16"/></Button>
     <Button x:Name="RedoButton" Click="Redo_Click" IsEnabled="False" AutomationProperties.AutomationId="RedoButton" AutomationProperties.Name="{Binding Text[Redo]}"><FontIcon Glyph="&#xE7A6;" FontSize="16"/></Button>
     <Button x:Name="RefreshButton" IsEnabled="{Binding IsReady}" Content="{Binding Text[Refresh]}" Click="Refresh_Click" AutomationProperties.AutomationId="RefreshButton"/>
     <Border Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,5"/>
     <Button x:Name="SortButton" IsEnabled="{Binding IsReady}" Click="Sort_Click" AutomationProperties.AutomationId="SortButton"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8CB;" FontSize="14"/><TextBlock x:Name="SortButtonText"/><FontIcon Glyph="&#xE70D;" FontSize="10"/></StackPanel></Button>
     <Button x:Name="ViewButton" IsEnabled="{Binding IsReady}" Click="View_Click" AutomationProperties.AutomationId="ViewButton"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8A9;" FontSize="14"/><TextBlock x:Name="ViewButtonText"/><FontIcon Glyph="&#xE70D;" FontSize="10"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="DetailsButton" Click="Details_Click" IsEnabled="{Binding HasSingleSelection}" AutomationProperties.AutomationId="DetailsButton"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE90F;" FontSize="14"/><TextBlock x:Name="DetailsButtonText"/></StackPanel></Button></StackPanel>
   </Grid>
  </Border>
  <Grid x:Name="Body" Grid.Row="3" SizeChanged="Body_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="226" MinWidth="160"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition x:Name="DetailsSplitterColumn" Width="0"/><ColumnDefinition x:Name="DetailsColumn" Width="0"/></Grid.ColumnDefinitions>
   <Grid x:Name="NavigationPanel" Padding="8,14,8,12" AutomationProperties.AutomationId="NavigationPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Text[Projects]}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="12,0,0,12"/>
    <ListView x:Name="NavigationList" CanDragItems="True" AllowDrop="True" DragItemsStarting="Navigation_DragItemsStarting" DragItemsCompleted="Navigation_DragItemsCompleted" DragOver="Navigation_DragOver" DragLeave="Navigation_DragLeave" Drop="Navigation_Drop" RightTapped="Navigation_RightTapped" Tapped="Navigation_Tapped" KeyDown="Navigation_KeyDown" Grid.Row="1" ContainerContentChanging="Navigation_ContainerContentChanging" ItemsSource="{Binding Navigation}" SelectionMode="Single" SelectionChanged="Navigation_Changed" IsEnabled="{Binding IsReady}" AutomationProperties.AutomationId="NavigationList" AutomationProperties.Name="Projects"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6,4"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="vm:NavigationEntry">
      <Grid Margin="{x:Bind RowMargin}" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="{x:Bind IconSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind SystemIconVisibility}"/>
       <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="17" services:ProjectIconColor.Key="{x:Bind Color}" Visibility="{x:Bind ProjectIconVisibility}"/>
       <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Visibility="{x:Bind NameVisibility}"/>
       <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Visibility="{x:Bind HeaderVisibility}"/>
       <TextBlock Grid.Column="2" Text="{x:Bind Count}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Visibility="{x:Bind CountVisibility}"/>
       <FontIcon Grid.Column="3" Glyph="&#xE840;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind PinVisibility}" IsHitTestVisible="False" AutomationProperties.Name="{Binding DataContext.Text[PinProject], ElementName=Root}"/>
      </Grid>
     </DataTemplate></ListView.ItemTemplate></ListView>
    <Border x:Name="NavigationDropIndicator" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Top" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1" CornerRadius="4"/>
    <SplitButton x:Name="NewProjectButton" Grid.Row="2" Margin="8,12,8,4" Content="{Binding Text[NewProject]}" Click="NewProject_Click" HorizontalAlignment="Stretch" IsEnabled="{Binding IsReady}" AutomationProperties.AutomationId="NewProjectButton">
     <SplitButton.Flyout><MenuFlyout><MenuFlyoutItem Text="{Binding Text[NewGroup]}" Click="NewGroup_Click" AutomationProperties.AutomationId="NewGroupMenu"/></MenuFlyout></SplitButton.Flyout>
    </SplitButton>
   </Grid>
   <controls:PaneSplitter x:Name="NavigationSplitter" Grid.Column="1" Style="{StaticResource SplitterStyle}" DragDelta="Splitter_DragDelta" DragCompleted="Splitter_DragCompleted" KeyDown="Splitter_KeyDown" AutomationProperties.AutomationId="NavigationSplitter" AutomationProperties.Name="Resize navigation pane"/>
   <Grid x:Name="ResourcePane" Grid.Column="2" Padding="8,4,8,8" AutomationProperties.AutomationId="ResourcePane"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="DetailsHeader" ColumnSpacing="12" Margin="8,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions><Button x:Name="NameHeader" Tag="Name" Style="{StaticResource HeaderStyle}" Click="SortHeader_Click" AutomationProperties.AutomationId="NameHeader"/><Button x:Name="ModifiedHeader" Grid.Column="1" Tag="Modified" Style="{StaticResource HeaderStyle}" Click="SortHeader_Click" AutomationProperties.AutomationId="ModifiedHeader"/><Button x:Name="TypeHeader" Grid.Column="2" Tag="Type" Style="{StaticResource HeaderStyle}" Click="SortHeader_Click" AutomationProperties.AutomationId="TypeHeader"/><Button x:Name="SizeHeader" Grid.Column="3" Tag="Size" Style="{StaticResource HeaderStyle}" HorizontalContentAlignment="Right" Click="SortHeader_Click" AutomationProperties.AutomationId="SizeHeader"/></Grid>
    <Grid Grid.Row="1">
     <ListView x:Name="ResourceList" CanDragItems="True" DragItemsStarting="Resource_DragItemsStarting" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource DetailsTemplate}" SelectionMode="Extended" IsEnabled="{Binding IsReady}" RightTapped="Resource_RightTapped" SelectionChanged="Resource_Changed" DoubleTapped="Resource_DoubleTapped" PointerPressed="Resource_PointerPressed" ContainerContentChanging="Resource_ContainerContentChanging" Background="Transparent" AutomationProperties.AutomationId="ResourceList" AutomationProperties.Name="Resources"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="30"/><Setter Property="Margin" Value="0"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListView.ItemContainerStyle></ListView>
     <GridView x:Name="ResourceGrid" CanDragItems="True" DragItemsStarting="Resource_DragItemsStarting" Visibility="Collapsed" ItemsSource="{Binding Rows}" ItemsPanel="{StaticResource HorizontalWrap}" SelectionMode="Extended" IsEnabled="{Binding IsReady}" RightTapped="Resource_RightTapped" SelectionChanged="Resource_Changed" DoubleTapped="Resource_DoubleTapped" PointerPressed="Resource_PointerPressed" ContainerContentChanging="Resource_ContainerContentChanging" Background="Transparent" AutomationProperties.AutomationId="ResourceGrid" AutomationProperties.Name="Resources"><GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></GridView.ItemContainerStyle></GridView>
     <Grid Visibility="{Binding EmptyVisibility}" Padding="32" IsHitTestVisible="False"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14"><FontIcon Glyph="&#xE8B7;" FontSize="44" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding EmptyTitle}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="{Binding EmptyHelp}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel></Grid>
    </Grid>
   </Grid>
   <controls:PaneSplitter x:Name="DetailsSplitter" Grid.Column="3" Visibility="Collapsed" Style="{StaticResource SplitterStyle}" DragDelta="Splitter_DragDelta" DragCompleted="Splitter_DragCompleted" KeyDown="Splitter_KeyDown" AutomationProperties.AutomationId="DetailsSplitter" AutomationProperties.Name="Resize details pane"/>
   <Border x:Name="DetailsPanel" Grid.Column="4" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" AutomationProperties.AutomationId="DetailsPanel">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Padding="20,14" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="{Binding Selected.Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SaveState}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="SaveState"/></StackPanel><Button x:Name="CloseDetailsButton" Grid.Column="1" VerticalAlignment="Top" Click="Details_Click" Padding="6" AutomationProperties.AutomationId="CloseDetailsButton"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button></Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsReady}">
                  <StackPanel Padding="20,0,20,24">
                    <InfoBar Visibility="{Binding MissingVisibility}" IsOpen="True" IsClosable="False" Severity="Warning" Message="{Binding MissingHelpText}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Text[Alias]}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AliasBox" SelectionHighlightColor="#0078D4" GotFocus="AliasBox_GotFocus" Text="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AliasBox" AutomationProperties.Name="Alias"/>
                    <TextBlock Text="{Binding Text[AliasHelp]}" Style="{StaticResource FieldHelp}"/>
                    <TextBlock Text="{Binding Text[Description]}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DescriptionBox" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="104" MaxHeight="180" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="DescriptionBox" AutomationProperties.Name="Description"/>
                    <TextBlock Text="{Binding Text[DescriptionHelp]}" Style="{StaticResource FieldHelp}"/>
                    <TextBlock Text="{Binding Text[Note]}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NoteBox" Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="NoteBox" AutomationProperties.Name="Note"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,22,0,0">
                      <Button Content="{Binding Text[Open]}" Click="Open_Click"/><Button Content="{Binding Text[OpenLocation]}" Click="Location_Click" Visibility="{Binding PhysicalVisibility}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Text[RealName]}" Style="{StaticResource FieldLabel}" Visibility="{Binding PhysicalVisibility}"/><TextBlock Text="{Binding Selected.RealName}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontSize="12" Visibility="{Binding PhysicalVisibility}"/>
                    <TextBlock Text="{Binding TargetLabel}" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Selected.Target}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontSize="12" Visibility="{Binding PhysicalVisibility}"/>
                    <TextBox x:Name="UrlTargetBox" Text="{Binding UrlTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Visibility="{Binding UrlVisibility}" AutomationProperties.AutomationId="UrlTargetBox" AutomationProperties.Name="URL"/>
                    <Button Content="{Binding CopyTargetLabel}" Click="CopyPath_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding Text[Type]}" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Selected.Type}"/>
                    <TextBlock x:Name="FileSizeLabel" Style="{StaticResource FieldLabel}" Visibility="{Binding PhysicalVisibility}"/><TextBlock Text="{Binding SelectedFileSizeText}" Visibility="{Binding PhysicalVisibility}"/>
                    <TextBlock x:Name="FileModifiedLabel" Style="{StaticResource FieldLabel}" Visibility="{Binding PhysicalVisibility}"/><TextBlock Text="{Binding SelectedModifiedText}" Visibility="{Binding PhysicalVisibility}"/>
                    <TextBlock Text="{Binding Text[Created]}" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding CreatedText}"/>
                    <TextBlock Text="{Binding Text[Updated]}" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding UpdatedText}"/>
                    <TextBlock Text="{Binding Text[LastOpened]}" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding LastOpenedText}"/>
                    <TextBlock Text="{Binding Text[OpenCount]}" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding OpenCountText}"/>
                  </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="18,14">
                  <ContentControl IsEnabled="{Binding IsReady}"><StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveButton" Content="{Binding Text[Save]}" Click="Save_Click" IsEnabled="{Binding IsDirty}" Style="{StaticResource AccentButtonStyle}" MinWidth="80" AutomationProperties.AutomationId="SaveButton"/>
                    <Button x:Name="DiscardButton" Content="{Binding Text[Discard]}" Click="Discard_Click" IsEnabled="{Binding IsDirty}" AutomationProperties.AutomationId="DiscardButton"/>
                  </StackPanel></ContentControl>
                </Border>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>




